{
  "expo": {
    "name": "Cardi",
    "slug": "cardi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cardi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.imriverjones.cardi",
      "supportsTablet": false,
      "deploymentTarget": "17.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cardi uses your location to get the forecast where you are. It's only used for the weather.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.imriverjones.cardi",
      "adaptiveIcon": {
        "backgroundColor": "#FFE2DE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFEDEB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cardi uses your location to get the forecast where you are. It's only used for the weather."
        }
      ],
      "expo-background-task",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.imriverjones.cardi",
          "widgets": [
            {
              "name": "CardiWidget",
              "displayName": "Cardi",
              "description": "What to wear, and your feels like, at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ]
            },
            {
              "name": "CheckInWidget",
              "displayName": "Cardi check-in",
              "description": "Tell Cardi how today felt, right from your Home Screen.",
              "supportedFamilies": [
                "systemSmall"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}